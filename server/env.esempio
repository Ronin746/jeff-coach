# Jeff Coach multi-edge sul server: compila e salva (in nano: Ctrl+O, Invio, Ctrl+X). Non mettere mai questo file su GitHub.
# Webhook Discord: Discord > canale > Modifica canale > Integrazioni > Webhook > Copia URL webhook.
# Scrivi ogni valore subito dopo l'uguale, senza spazi e senza virgolette.

# Sydney: unico canale per card e alert (dal 14/10)
COACH_ALERT_DISCORD_WEBHOOK_URL=
# Token GitHub per salvare lista, card e giornale nel repo (fine-grained, solo Ronin746/jeff-coach, Contents: Read and write)
GITHUB_TOKEN=
# Basket di Lone Stock Trader (temi): di solito NON serve niente qui, perché Dua li legge il lunedì alle 01:00 e questo
# bot copia la stessa lettura (~/.lst). Solo se i bot di Martin non girano su questo server: i valori dei cookie
# sb-lcebbiuqiwmnystasuma-auth-token.0 e .1 di app.lonestocktrader.com (finestra in incognito, chiusa senza logout).
LST_TOKEN_0=
LST_TOKEN_1=

# Le righe di prima (DISCORD_WEBHOOK_URL di Remy, REMY_ATTIVO, COACH_CARD_DISCORD_WEBHOOK_URL di Dua) non servono più:
# il nuovo Jeff Coach non le legge.
